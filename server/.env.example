APP_NAME=Click Lake Collector
ALLOW_ORIGINS=["*"]
RAW_EVENTS_BASE_REL_DIR=server/data/raw_events
MAX_EVENTS_PER_FILE=1000

# Databricks Gold read-only API
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=<pat-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
GOLD_QUERY_LIMIT=500
GOLD_API_CACHE_TTL_SECONDS=20
GOLD_WARMUP_ON_STARTUP=true

# Kafka producer (ingest /collect 병행 publish)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_EVENTS=clicklake.events.raw
KAFKA_CLIENT_ID=clicklake-server
KAFKA_PUBLISH_TIMEOUT_SECONDS=3
COLLECT_DIRECT_RAW_ENABLED=false
COLLECT_REQUIRE_KAFKA_PUBLISH=true
WEB_CONCURRENCY=4

# Slack slash command (MVP query mode)
SLACK_SIGNING_SECRET=<replace-me>
SLACK_ENABLE_SIGNATURE_VALIDATION=false

# Databricks upload targets (direct / kafka source 분리)
# legacy: DATABRICKS_VOLUME_PATH=/Volumes/workspace/clicklake_bronze/raw_batches
# new:
DATABRICKS_VOLUME_PATH_DIRECT=/Volumes/workspace/clicklake_bronze/raw_batches/direct
DATABRICKS_VOLUME_PATH_KAFKA=/Volumes/workspace/clicklake_bronze/raw_batches/kafka
